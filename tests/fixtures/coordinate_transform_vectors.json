{
  "description": "Test vectors for metersToMapCoords / local_to_gps coordinate transforms",
  "algorithm": {
    "meters_per_degree_lat": 111320.0,
    "meters_per_degree_lng": "111320.0 * cos(origin_lat_rad)",
    "lat": "origin_lat + (north / meters_per_degree_lat)",
    "lng": "origin_lng + (east / meters_per_degree_lng)"
  },
  "test_vectors": [
    {
      "name": "equator_east_1000m",
      "description": "1000m east at equator",
      "origin": { "lat": 0.0, "lng": 0.0 },
      "input": { "east": 1000.0, "north": 0.0 },
      "expected": { "lng": 0.008983111749910169, "lat": 0.0 },
      "tolerance": 1e-9
    },
    {
      "name": "equator_north_1000m",
      "description": "1000m north at equator",
      "origin": { "lat": 0.0, "lng": 0.0 },
      "input": { "east": 0.0, "north": 1000.0 },
      "expected": { "lng": 0.0, "lat": 0.008983111749910169 },
      "tolerance": 1e-9
    },
    {
      "name": "mid_lat_east_1000m",
      "description": "1000m east at 45°N (shorter longitude degrees)",
      "origin": { "lat": 45.0, "lng": -90.0 },
      "input": { "east": 1000.0, "north": 0.0 },
      "expected": { "lng": -89.98729596153096, "lat": 45.0 },
      "tolerance": 1e-9
    },
    {
      "name": "mid_lat_north_1000m",
      "description": "1000m north at 45°N",
      "origin": { "lat": 45.0, "lng": -90.0 },
      "input": { "east": 0.0, "north": 1000.0 },
      "expected": { "lng": -90.0, "lat": 45.00898311174991 },
      "tolerance": 1e-9
    },
    {
      "name": "diagonal_NE_1000m",
      "description": "1000m NE (707m E + 707m N) at equator",
      "origin": { "lat": 0.0, "lng": 0.0 },
      "input": { "east": 707.1067811865476, "north": 707.1067811865476 },
      "expected": { "lng": 0.006352019234518034, "lat": 0.006352019234518034 },
      "tolerance": 1e-9
    },
    {
      "name": "west_1000m",
      "description": "1000m west at equator (negative east)",
      "origin": { "lat": 0.0, "lng": 0.0 },
      "input": { "east": -1000.0, "north": 0.0 },
      "expected": { "lng": -0.008983111749910169, "lat": 0.0 },
      "tolerance": 1e-9
    },
    {
      "name": "south_1000m",
      "description": "1000m south at equator (negative north)",
      "origin": { "lat": 0.0, "lng": 0.0 },
      "input": { "east": 0.0, "north": -1000.0 },
      "expected": { "lng": 0.0, "lat": -0.008983111749910169 },
      "tolerance": 1e-9
    },
    {
      "name": "southern_hemisphere",
      "description": "1000m east at 30°S",
      "origin": { "lat": -30.0, "lng": 151.0 },
      "input": { "east": 1000.0, "north": 0.0 },
      "expected": { "lng": 151.01037280397395, "lat": -30.0 },
      "tolerance": 1e-9
    }
  ]
}
