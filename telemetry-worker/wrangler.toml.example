name = "stalagmight-telemetry"
main = "src/index.ts"
compatibility_date = "2025-12-01"

[observability]
enabled = true
head_sampling_rate = 1  # 1 = log 100% of requests; reduce if volume grows

[[d1_databases]]
binding = "DB"
database_name = "stalagmight-telemetry"
database_id = ""  # Run `wrangler d1 list` to find your database ID
