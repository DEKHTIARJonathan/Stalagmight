{
  "name": "stalagmight",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:watch": "wdio run wdio.conf.ts --watch",
    "test:ui": "playwright test",
    "test:ui:smoke": "playwright test --grep @smoke",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "coverage:ui": "E2E_COVERAGE=1 VITE_COVERAGE=1 pnpm test:ui",
    "coverage:e2e": "E2E_COVERAGE=1 VITE_COVERAGE=1 pnpm test:e2e",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "gen:ipc-types": "cargo run --manifest-path src-tauri/Cargo.toml --bin gen_ipc_types",
    "test:all": "pnpm test && pnpm test:ui",
    "release": "./scripts/release.sh"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.35",
    "@deck.gl/layers": "^9.0.35",
    "@deck.gl/mapbox": "^9.0.35",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.3",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^7.2.1",
    "maplibre-gl": "^5.16.0",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.12",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "@wdio/cli": "^9.23.0",
    "@wdio/local-runner": "^9.23.0",
    "@wdio/mocha-framework": "^9.23.0",
    "@wdio/spec-reporter": "^9.20.0",
    "autoprefixer": "^10.4.20",
    "nyc": "^17.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^2.1.5",
    "webdriverio": "^9.23.0"
  }
}
